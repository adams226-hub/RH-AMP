PORT=4000
NODE_ENV=development

# Chaîne de connexion PostgreSQL Supabase (Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres:motdepasse@db.xxxxxxxx.supabase.co:5432/postgres

# Secret de signature JWT — générer une valeur aléatoire longue en production
JWT_SECRET=change_moi_en_production_avec_une_valeur_aleatoire_longue
JWT_EXPIRES_IN=8h

# Requis uniquement quand le module Archivage (Supabase Storage) sera implémenté
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Requis uniquement pour exécuter database/appliquer-schema.mjs (création des tables via l'API Management)
# Token : https://supabase.com/dashboard/account/tokens — ne jamais commiter cette valeur
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
